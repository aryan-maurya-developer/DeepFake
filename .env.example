# DeepFake Configuration
# Copy this file to .env and adjust values as needed

# API Configuration
PORT=8000
DEEPFAKE_CONFIG_FILE_PATH=./config/deepfake_config.local.json
META_MODEL_ARTIFACTS_DIR=./api/meta_model_artifacts
LOG_LEVEL=INFO
FRONTEND_PORT=3000

# Model Service Ports
NPR_PORT=5001
UNIVERSAL_PORT=5004
CROSS_EFFICIENT_VIT_PORT=7001
AUDIO_PORT=8001

# Model Configuration
USE_GPU=false
MODEL_TIMEOUT=600
CACHE_TTL_SECONDS=900
CACHE_MAX_ITEMS=256
MONGO_URI=
MONGO_DB_NAME=deepfake_platform
MONGO_COLLECTION_NAME=analysis_history
